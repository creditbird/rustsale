{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "preferred": { "type": "string", "enum": ["A", "B", "TIE"] },
    "summary": { "type": "string", "minLength": 1 },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "score_a": { "type": "integer", "minimum": 1, "maximum": 20 },
          "score_b": { "type": "integer", "minimum": 1, "maximum": 20 },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "blockers_a": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "blockers_b": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "required": ["id", "score_a", "score_b", "evidence", "blockers_a", "blockers_b"]
      }
    },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "required": ["preferred", "summary", "criteria", "limitations"]
}
