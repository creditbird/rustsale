# Maintainer: RustSale Packagers <packaging@rustsale.invalid>
# Repackages the output of `nsh package --target linux` (build it first; see README.md).
# Put the tarball made by `packaging/linux/build-tarball.sh` next to this file, then run `makepkg`.
pkgname=rustsale
pkgver=0.1.0
pkgrel=1
pkgdesc='Sales CRM for customer conversations and outreach (GTK 4)'
arch=('x86_64')
url='https://github.com/creditbird/rustsale'
license=('custom:proprietary')
# The runner links webkitgtk-6.0 (libwebkitgtk-6.0.so.4, libjavascriptcoregtk-6.0.so.1) and gtk4 at load
# time (DT_NEEDED), even though the app opens no web view: pacman must install both.
depends=('webkitgtk-6.0' 'gtk4')
options=('!strip' '!debug')
source=("$pkgname-$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cp -a "$srcdir/root/." "$pkgdir/"
}
