{
  "name": "tauri-app",
  "version": "0.1.13",
  "description": "",
  "type": "module",
  "scripts": {
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations",
    "dev": "bun run i18n:compile && vite dev",
    "build": "bun run i18n:compile && vite build",
    "build:cloak-runtime": "bun run scripts/build-cloak-runtime.ts",
    "preview": "vite preview",
    "check": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun run i18n:compile && bun test --conditions=browser --conditions=svelte",
    "test:cloak-runtime": "bun test sidecars/cloak-runtime/src",
    "release": "bun run scripts/publish-release.ts",
    "release:r2": "bun run scripts/generate-r2-release.ts",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "chromium-bidi": "11.0.0",
    "cloakbrowser": "0.5.1",
    "lucide-svelte": "^1.0.1",
    "playwright-core": "1.57.0",
    "qrcode": "^1.5.4",
    "runed": "^0.28.0",
    "svelte-sonner": "^1.1.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@inlang/paraglide-js": "^2.24.1",
    "@inlang/plugin-m-function-matcher": "^2.2.11",
    "@inlang/plugin-message-format": "^4.4.3",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.28.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/svelte": "^5.4.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "bits-ui": "^2.16.3",
    "bun-types": "^1.3.14",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.4.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}