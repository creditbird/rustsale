# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# VietQR / SePay / PayOS Bank Configuration
VITE_VIETQR_BANK_ID=ICB
VITE_VIETQR_ACCOUNT_NO=101874355801
VITE_VIETQR_ACCOUNT_NAME=TRAN TRONG TRI

# Tauri v2 Auto-Update & Signing Key
TAURI_SIGNING_PRIVATE_KEY_PATH=/path/to/your/rustsale.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Cloudflare R2 Release Distribution
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
R2_BUCKET_NAME=rustsale-releases
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Cloudflare R2 S3 API Credentials (for automated 1-click release upload)
# R2_ACCESS_KEY_ID=your_r2_access_key_id_here
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
