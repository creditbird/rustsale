{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustSale CRM",
  "version": "0.1.2",
  "identifier": "com.rustsale.crm",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:cloak-runtime && bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "RustSale CRM & Outreach Pro",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/cloak-runtime"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
